# CareerPilot Environment Configuration Example
# Copy this file to .env and configure secrets accordingly.

# Django Security
SECRET_KEY=django-insecure-careerpilot-key-for-local-development-90days-day14
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database Configuration (PostgreSQL primary, SQLite fallback if omitted)
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot
# Leave DATABASE_URL blank to automatically use local SQLite:
DATABASE_URL=

# Explicit PostgreSQL environment parameters (alternative to DATABASE_URL)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
